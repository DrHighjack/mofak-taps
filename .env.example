# copy to .env and fill in
ADMIN_PASSWORD=change-me            # admin login
SECRET_KEY=change-me-long-random    # signs the login cookie; any long random string
DB_PASSWORD=change-me-too
PUBLIC_URL=http://localhost:8000   # used to build the tag links on the Tags page
APP_TZ=America/Los_Angeles
# Local backups are on the same disk as Docker by default. Set to a mounted SSD path
# (for example /mnt/backup-ssd/streamclock) to keep a separate copy.
BACKUP_DIR=./backups
# Set these to the results of id -u and id -g on the host that owns the backup folder.
BACKUP_UID=1000
BACKUP_GID=1000
# For manual host backups, optionally require this SSD root to be mounted.
# BACKUP_MOUNT=/mnt/backup-ssd
# Only trust the actual reverse proxy addresses; never use * on an untrusted network.
FORWARDED_ALLOW_IPS=127.0.0.1
# When enabling the tunnel, set FORWARDED_ALLOW_IPS=172.30.0.2 (the proxy address below).
# Change both values if this subnet conflicts with an existing host/Docker network.
TUNNEL_PROXY_SUBNET=172.30.0.0/24
TUNNEL_PROXY_IP=172.30.0.2
# Optional Cloudflare Tunnel profile. Create a remotely-managed tunnel and add its token here.
# CLOUDFLARE_TUNNEL_TOKEN=
# Google Sheets (optional). Share the sheet with the service account email as Editor.
# GOOGLE_SERVICE_ACCOUNT_JSON=/srv/secrets/service-account.json
# GOOGLE_SHEET_ID=1AbC...the id from the sheet URL
